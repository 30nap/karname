# Copy to .env and fill in. Never commit .env.

# Database password (any long random string): openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts stored AI and price-source API keys (32 bytes, Base64): openssl rand -base64 32
# Back it up together with the database: without it, stored keys cannot be decrypted.
KARNAME_SECRET_KEY=

# Where the app listens on this machine. 127.0.0.1 = only through a reverse proxy on the same
# host (recommended, for HTTPS); 0.0.0.0 = directly on the network.
KARNAME_BIND=127.0.0.1
KARNAME_HTTP_PORT=8080

# Set both when the app is served over HTTPS (behind Caddy, Traefik, a CDN…).
KARNAME_COOKIE_SECURE=false
# e.g. max-age=31536000
KARNAME_HSTS=
# The address(es) of that proxy as seen by this stack (CIDR, space separated), so sign-in limits
# apply per visitor rather than to everyone at once; e.g. 172.16.0.0/12 for a proxy on this host.
KARNAME_REAL_IP_FROM=

KARNAME_TIMEZONE=Asia/Tehran
KARNAME_SESSION_TIMEOUT=12h

# Optional: with an Anthropic API key here, a Claude provider is set up on first start
# (the key stays in the environment and is never stored in the database).
ANTHROPIC_API_KEY=
# AI requests per user per day until an administrator changes it in the settings.
KARNAME_AI_DAILY_LIMIT=100

# Demo: creates the user "demo" with six months of sample data on start-up.
# KARNAME_AI_FAKE adds an offline scripted assistant (demos only, never for real use).
KARNAME_DEMO=false
KARNAME_DEMO_PASSWORD=
KARNAME_AI_FAKE=false

# Extra JVM options, e.g. -Xmx512m
JAVA_TOOL_OPTIONS=
